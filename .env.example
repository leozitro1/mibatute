VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_imagekit_id
VITE_HOME_PAGE_SIZE=12
VITE_MAX_HOME_ARTICLES=48
VITE_MAX_CHAT_MESSAGES=50
VITE_NOTIFICATIONS_REFRESH_MS=300000

# Solo en Vercel/server. Nunca exponer IMAGEKIT_PRIVATE_KEY en frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
IMAGEKIT_PUBLIC_KEY=public_xxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_imagekit_id

# Wompi: solo servidor, sin prefijo VITE_. Empezar con llaves sandbox.
WOMPI_ENABLED=false
WOMPI_ENVIRONMENT=test
WOMPI_PUBLIC_KEY=pub_test_xxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxx
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Activity email delivery (server only). Auth SMTP is configured separately in Supabase.
# Requires the corresponding Superadmin switches, a verified Resend sender and private service credentials.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
CRON_SECRET=
