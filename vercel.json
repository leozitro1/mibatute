{
  "rewrites": [
    {
      "source": "/gestion/:path*",
      "destination": "/seo/gestion-operaciones.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/seo/auth-callback.html"
    },
    {
      "source": "/reset-password",
      "destination": "/seo/reset-password.html"
    },
    {
      "source": "/terminos",
      "destination": "/seo/terminos.html"
    },
    {
      "source": "/privacidad",
      "destination": "/seo/privacidad.html"
    },
    {
      "source": "/pagos",
      "destination": "/seo/pagos.html"
    },
    {
      "source": "/cookies",
      "destination": "/seo/cookies.html"
    },
    {
      "source": "/datos-personales",
      "destination": "/seo/datos-personales.html"
    },
    {
      "source": "/normas",
      "destination": "/seo/normas.html"
    }
  ],
  "headers": [
    {
      "source": "/gestion/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/auth/callback",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
